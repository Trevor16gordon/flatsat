# Host profile: Jetson Orin Nano devkit (hostname jetson) — placement truth.
#
# Maps abstract core ROLES from flight/processes.toml to THIS board's
# topology (6x Cortex-A78AE, cores 0-5). Everything that touches placement
# derives from this file: unit generation now; the A1 isolation pass
# (isolcpus/nohz_full/IRQ affinity kernel cmdline) must use the SAME
# RT_CORE when that session happens — one source, no drift.

PYTHON=/home/trevor/venvs/flatsat-ml/bin/python
WORKDIR=/home/trevor/flatsat

# The core reserved for hard-cadence loops (future isolcpus target).
RT_CORE=3

# Where everything else runs, keeping the RT core clean.
HOUSEKEEPING_CPUS=0-2,4-5
